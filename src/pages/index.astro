<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iván Sevilla</title>

    <script is:inline>
        // Detectamos el idioma del navegador del usuario
        const userLang = navigator.language || navigator.userLanguage;

        // Operador ternario: si es español, a /es/, si no, el default a /en/ (o el que sea tu base)
        const targetUrl = userLang.startsWith('es') ? '/es/' : '/en/';

        // IMPORTANTE: Usamos .replace() en lugar de .href
        // Esto borra esta página en blanco del historial del navegador.
        // Si usas .href, cuando el usuario le dé al botón "Atrás", volverá aquí y entrará en un bucle infinito.
        window.location.replace(targetUrl);
    </script>
</head>
<body style="background-color: #0d0d0d; margin: 0;">
</body>
</html>