---
import Header from "../components/Header.astro"
---
<!-- Esto es el layout, sirve como una plantilla que se mantendrá en toda la web sin tener que repetir el head y body -->
<html>
<head>
    <title>Iván Sevilla Gómez, estudiante de ingenieria</title>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <Header></Header>
    <main class = "container">
    <slot></slot> <!-- El slot sirve como indicador de onde tiene que aparecer el contenido de la página -->
    </main>
    <style>
        body{
            background-color: #C0F8D1;
            color: #104547;
            font-family: "Archivo", serif;
        }
        .container{
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
        }
    </style>
</body>
</html>