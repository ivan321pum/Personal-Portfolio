---
import Header from "../components/Header.astro"
import {useTranslations} from "../i18n/ui.js";
import LanguagePicker from "../components/LanguagePicker.astro";

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---
<!-- Esto es el layout, sirve como una plantilla que se mantendrá en toda la web sin tener que repetir el head y body -->
<html>
<head>
    <title>{t('hero.title')}</title>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <LanguagePicker></LanguagePicker>
    <Header></Header>
    <main class = "container">
    <slot></slot> <!-- El slot sirve como indicador de onde tiene que aparecer el contenido de la página -->
    </main>
    <style is:global>
        /* 1. RESET ARQUITECTÓNICO INNEGOCIABLE */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            /* IMPORTANTE: Eliminamos el overflow del body.
               Permitimos que el scroll de la página sea natural. */
            overflow-x: visible;
            width: 100%;
        }

        /* 2. VARIABLES */
        :root {
            --color-primario: #D72638;
            --color-secundario: #104547;
            --color-fondo: #C0F8D1;
            --color-texto: #333333;
            --color-fondo-secundario: #FF9F1C;
        }

        /* 3. ESTILOS BASE */
        body {
            background-color: var(--color-fondo);
            color: var(--color-texto);
            font-family: "Archivo", serif;
        }

        /* 4. EL CONTENEDOR (Opcional para el Hero) */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
        }
    </style>
</body>
</html>