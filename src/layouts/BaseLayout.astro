---
import Header from "../components/Header.astro";
import { useTranslations } from "../i18n/ui.js";
import LanguagePicker from "../components/LanguagePicker.astro";
import ThemePicker from "../components/ThemePicker.astro";
import Footer from "../components/Footer.astro";
import ShadowCursor from "../components/react/MouseShadow";
import "@fontsource-variable/manrope";
import "../styles/global.css";

const lang = Astro.currentLocale || "es";
const t = useTranslations(lang);
---

<!-- Esto es el layout, sirve como una plantilla que se mantendrá en toda la web sin tener que repetir el head y body -->
<html lang={lang}>
	<head>
		<!-- Open Graph (WhatsApp, LinkedIn, Discord) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://ivansevilla.me/" />
		<meta property="og:title" content="Iván Sevilla | Software Developer" />
		<meta
			property="og:description"
			content="Portafolio personal. Estudiante de ingeniería informática en la UPV."
		/>
		<meta
			property="og:image"
			content="https://ivansevilla.me/images/og-image.webp"
		/>

		<!-- Twitter Cards (X) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://ivansevilla.me/" />
		<meta
			name="twitter:title"
			content="Iván Sevilla | Software Developer"
		/>
		<meta
			name="twitter:description"
			content="Portafolio personal. Estudiante de ingeniería informática en la UPV."
		/>
		<meta
			name="twitter:image"
			content="https://ivansevilla.me/images/og-image.webp"
		/>
		<title>{t("hero.title")}</title>
		<meta charset="utf-8" />
		<link rel="alternate" hreflang="es" href="https://ivansevilla.me/es/" />
		<link rel="alternate" hreflang="en" href="https://ivansevilla.me/en/" />
		<link
			rel="alternate"
			hreflang="ca"
			href="https://ivansevilla.me/cat/"
		/>
		<link rel="alternate" hreflang="nl" href="https://ivansevilla.me/nl/" />
		<link
			rel="alternate"
			hreflang="x-default"
			href="https://ivansevilla.me/en/"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	</head>
	<body>
		<script
			src="https://web3forms.com/client/script.js"
			async
			defer
		></script>
		<ShadowCursor client:load>
			<div>
				<LanguagePicker />
				<ThemePicker />
			</div>
			<section id="header">
				<Header />
			</section>

			<main class="mx-auto max-md:px-4">
				<slot />
				<!-- El slot sirve como indicador de onde tiene que aparecer el contenido de la página -->
			</main>
			<Footer />
			<style is:global>
				*,
				*::before,
				*::after {
					transition-property:
						background-color, color, border-color, fill, stroke;
					transition-duration: 500ms;
					transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
				}
			</style>
		</ShadowCursor>
	</body>
</html>
