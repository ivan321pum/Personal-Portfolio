---
import Navigation from "./Navigation.astro";
import { Image } from "astro:assets";
import avatarImg from "../../public/assets/images/avatar_ivan.webp";
---
<header class="header-outer">
    <div class="header-inner">
        <div class="logo">
            <div class="profile-frame">
                <Image src={avatarImg} alt="Foto de Iván" class="profile-pic" loading="eager" />
            </div>
            <div class="text-group">
                <span class="name-text">Iván Sevilla</span>
                <span class="status-dot">Online</span>
            </div>
        </div>
        <Navigation></Navigation>
    </div>
</header>

<style>
    .header-outer {
        background-color: var(--color-fondo-secundario);
        width: 100%;
        color: var(--color-secundario);
        /* Eliminamos los prefijos -moz- y usamos estándar */
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
        box-sizing: border-box;
        /* Profundidad sobre el fondo */
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 100;
    }

    .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem; /* Más alto para "llenar" más */
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 16px; /* Más aire */
    }

    .text-group {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

    .name-text {
        font-weight: 900;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
    }

    .status-dot {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.8;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .status-dot::before {
        content: "•";
        color: #4ade80; /* Un verde vibrante */
        display: inline-block;
    }

    .profile-frame {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        border: 3px solid var(--color-fondo); /* Contraste con el naranja */
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .profile-pic {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* --- RESPONSIVE DE INGENIERÍA --- */
    @media (max-width: 768px) {
        .header-inner {
            padding: 1rem;
            flex-direction: column;
            gap: 1rem;
        }

        .logo {
            gap: 8px;
        }

        .name-text {
            font-size: 1.2rem;
        }

        .profile-frame {
            width: 45px;
            height: 45px;
        }

        .status-dot {
            display: none; /* Limpiamos ruido en móvil */
        }
    }
</style>