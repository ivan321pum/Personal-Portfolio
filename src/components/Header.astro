---
import Navigation from "./Navigation.astro"
---
<!-- Esta es la cabezera superior de la web -->
<header class = "header-outer">
    <div class = "header-inner">
        <div class = "logo">
            <div class="profile-frame">
                <img src="/assets/images/avatar_ivan.webp" alt="Foto de Iván" class="profile-pic" />
            </div>
            <span class="name-text">Iván Sevilla Gómez</span>
        </div>
        <Navigation></Navigation>
    </div>
</header>
<style>
    .header-outer {
        background-color: var(--color-fondo-secundario);
        width: 100%;
        color: var(--color-secundario); /* Verde oscuro para el texto */
        border-radius: 15px;
    }

    .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem; /* Espaciado vertical */
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
    }

    .logo {
        font-weight: bold;
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-frame {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden; /*Lo que sobra de la imagen se vea oculto*/
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .profile-pic {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

</style>