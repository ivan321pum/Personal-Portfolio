---
import Navigation from "./Navigation.astro"
---
<header class="header-outer">
    <div class="header-inner">
        <div class="logo">
            <div class="profile-frame">
                <img src="/assets/images/avatar_ivan.webp" alt="Foto de Iván" class="profile-pic" />
            </div>
            <span class="name-text">Iván Sevilla Gómez</span>
        </div>
        <Navigation></Navigation>
    </div>
</header>

<style>
    /* Variables asumidas (asegúrate de tenerlas definidas en tu CSS global) */
    .header-outer {
        background-color: var(--color-fondo-secundario);
        width: 100%;
        color: var(--color-secundario);
        border-radius: 15px;
        box-sizing: border-box; /* Evita desbordamientos por padding */
    }

    .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .logo {
        font-weight: bold;
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-frame {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0; /* Evita que la foto se deforme si falta espacio */
    }

    .profile-pic {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* --- ESTILOS RESPONSIVE --- */
    @media (max-width: 768px) {
        .header-inner {
            flex-direction: column; /* Apila el logo y la navegación verticalmente */
            gap: 1.5rem; /* Espacio entre el logo y el menú */
            padding: 1.5rem 1rem;
        }

        .logo {
            font-size: 1.5rem; /* Reducimos el tamaño de la fuente para que no ocupe todo el ancho */
            flex-direction: column; /* Apilamos la foto y el nombre */
            text-align: center;
            gap: 8px;
        }

        .profile-frame {
            width: 65px; /* Reducimos el tamaño de la imagen en móviles */
            height: 65px;
        }
    }
</style>