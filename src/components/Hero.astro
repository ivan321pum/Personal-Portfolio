---
import TitleAnimation from "../components/AnimatedHero.jsx"
---

<section>
    <TitleAnimation client:load></TitleAnimation>
</section>

<style>
    section {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
    }

    :global(.hero-title) {
        font-size: 8rem;
        color: #D72638;
        margin: 0;
        display: inline-block;
    }

    :global(.hero-subtitle) {
        font-size: 3rem;
        color: #104547;
        font-weight: 400;
        margin-top: 1rem;
        display: inline-block;
    }
</style>