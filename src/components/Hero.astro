---
import TitleAnimation from "./react/AnimatedHero.jsx";
import { useTranslations } from "../i18n/ui";
const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---

<section class="h-[calc(100vh-100px)] min-h-[calc(100vh-100px)] w-full flex flex-col justify-center items-center text-center px-4 m-0 bg-fondo relative max-md:h-[calc(100svh-110px)] max-md:min-h-[calc(100svh-110px)]">
    <TitleAnimation
            client:load
            title={t('hero.title')}
            subtitle={t('hero.subtitle')}
    />

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-[0.8rem] font-bold tracking-[0.2em] text-[0.75rem] text-primario opacity-80">
        <span>{t('hero.scroll')}</span>
        <div class="w-[2px] h-[60px] bg-primario animate-[pulse-line_2s_infinite_ease-in-out]"></div>
    </div>
</section>
