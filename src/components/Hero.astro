---
import type { title } from "framer-motion/m";
import TitleAnimation from "./react/AnimatedHero.jsx"
import {useTranslations} from "../i18n/ui";

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---

<section>
    <TitleAnimation
            client:load
            title = {t('hero.title')}
            subtitle = {t('hero.subtitle')}
    ></TitleAnimation>
</section>

<style>
    section {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
    }

    :global(.hero-title) {
        font-size: 8rem;
        color: var(--color-primario);
        margin: 0;
        display: inline-block;
    }

    :global(.hero-subtitle) {
        font-size: 3rem;
        color: var(--color-secundario);
        font-weight: 400;
        margin-top: 1rem;
        display: inline-block;
    }
</style>