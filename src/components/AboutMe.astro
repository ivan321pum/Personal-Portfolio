---
import InfoCard from "./react/InfoCard";
import {useTranslations} from "../i18n/ui";
import type { title } from "framer-motion/client";

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---

<div class="cards-container">
    <InfoCard
            client:visible
            title={t('about.facets.telecom.title')}
            description={t('about.facets.telecom.desc')}
            direction="left"
    />

    <InfoCard
            client:visible
            title={t('about.facets.software.title')}
            description={t('about.facets.software.desc')}
            direction="right"
            delay={0.2}
    />

    <InfoCard
            client:visible
            title={t('about.facets.discipline.title')}
            description={t('about.facets.discipline.desc')}
            direction="left"
            delay={0.4}
    />
</div>