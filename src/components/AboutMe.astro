---
import InfoCard from "./react/InfoCard";
import {useTranslations} from "../i18n/ui";

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---

<div class="cards-container" style="display: flex; flex-direction: column; gap: 0;">
    <InfoCard
            client:visible
            title={t('about.facets.telecom.title')}
            subtitle={t('about.facets.software.title')}
            description={t('about.facets.telecom.desc')}
            direction="left"
            videoSrc="../../assets/videos/ETSIT-25-seg.mp4"
            bkcgroundColor={'var(--color-fondo-secundario)'}
            titleColor={'var(--color-secundario)'}
            subtitleColor={'var(--color-fondo)'}
    />
    <InfoCard
            client:visible
            title={t('about.facets.software.title')}
            subtitle={t('about.facets.software.title')}
            description={t('about.facets.software.desc')}
            direction="right"
            videoSrc="../../assets/videos/ETSIT-25-seg.mp4"
            bkcgroundColor={'var(--color-fondo)'}
            titleColor={'var(--color-primario)'}
            subtitleColor={'var(--color-fondo-secundario)'}
    />
</div>


<style>
    /* EL ROMPE-CONTENEDORES ABSOLUTO */
    #sobre-mi {
        /* Fuerza la sección al centro absoluto de la pantalla */
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;
        background-color: var(--color-fondo);
        /* Aseguramos que no haya espacio extra */
        padding: 0;
        /* IMPORTANTE: No cortes el flujo horizontal todavía */
        overflow: visible;
    }

    .cards-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
</style>