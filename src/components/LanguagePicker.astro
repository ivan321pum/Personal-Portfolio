---
const {pathname} = Astro.url; /*cogemos la url actual del usuario*/

const currentLang = pathname.split("/")[1]

const targetLang = currentLang === 'es' ? 'en' : 'es';

const targetUrl = pathname.replace(`/${currentLang}`, `/${targetLang}`)
---

<a href={targetUrl} class="fixed bottom-8 right-8 z-[1000] flex justify-center items-center min-w-[60px] h-[60px] bg-secundario text-fondo no-underline font-bold text-[1.1rem] rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.15)] transition-all duration-300 ease-in-out hover:bg-primario">
    {targetLang.toUpperCase()}
</a>

