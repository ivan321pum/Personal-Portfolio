---
import DockLayout from "./DockLayout.astro";
import { ui } from "../i18n/ui";

const { pathname } = Astro.url; /*cogemos la url actual del usuario*/
const currentLang = pathname.split("/")[1];
var page = pathname.split("/").slice(2).join("/");

if (page == "index") {
	page = "";
}

const languages = Object.keys(ui);
---

<DockLayout position="derecha" label="Cambiar idioma">
	<span slot="trigger" class="font-bold text-[1.1rem]">
		{currentLang.toUpperCase()}
	</span>
	<nav
		slot="menu"
		class="flex flex-col gap-1 w-full text-center min-w-[80px]"
	>
		{languages.map((lang) => (
			<a
				href={`/${lang}/${page}`}
				class="rounded p-2 font-bold hover:bg-secundario/10 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primario"
			>
				{lang.toUpperCase()}
			</a>
		))}
	</nav>
</DockLayout>
