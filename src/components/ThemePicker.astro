---
import DockLayout from "./DockLayout.astro";

// 1. Definimos los temas disponibles (nombres de los álbumes)
const temas = ["news-of-the-world", "queen-ii", "a-night-at-the-opera", "jazz", "the-game"];
---

<DockLayout position="izquierda">
  <span slot="trigger" id="theme-text" class="font-bold text-[1.1rem]">
    NEWS OF THE WORLD
  </span>
  
  <nav slot="menu" class="flex flex-col gap-1 w-full text-center min-w-[150px]">
    {temas.map((tema) => (
      <button 
        data-theme={tema}
        class="theme-btn p-2 hover:bg-secundario/10 rounded transition-colors font-bold capitalize"
      >
        {tema.replace(/-/g, " ")}
      </button>
    ))}
  </nav>
</DockLayout>

<script>
  // Seleccionamos todos los botones con la clase 'theme-btn'
  const buttons = document.querySelectorAll('.theme-btn');
  // Seleccionamos el texto del trigger para actualizarlo visualmente
  const triggerText = document.querySelector('#theme-text');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Obtenemos el valor del atributo data-theme
      const newTheme = button.getAttribute('data-theme');
      
      if (newTheme) {
        // 2. Cambiamos la clase del <html> para activar los estilos del tema
        document.documentElement.className = newTheme;
        
        // 3. Actualizamos el texto del botón principal (trigger)
        if (triggerText) {
          triggerText.textContent = newTheme.replace(/-/g, ' ').toUpperCase();
        }
      }
    });
  });
</script>