---
import DockLayout from "./DockLayout.astro";
import { THEMES, DEFAULT_THEME } from "../data/themes";
import { Icon } from "astro-icon/components";
---

<DockLayout position="izquierda">
	<Icon slot="trigger" name="mdi:palette" class="w-6 h-6" />

	<nav
		slot="menu"
		class="flex flex-col gap-1 w-full text-center min-w-[180px]"
	>
		{THEMES.map((tema) => (
			<button
				data-theme-id={tema.id}
				data-theme-class={tema.className}
				class="theme-btn p-3 hover:bg-secundario/20 rounded transition-colors font-semibold text-sm"
			>
				{tema.displayName}
			</button>
		))}
	</nav>
</DockLayout>

<script>
	const THEME_STORAGE_KEY = "selected-theme";
	const DEFAULT_THEME = "the-miracle";

	// Aplicar tema guardado al cargar
	function applyStoredTheme() {
		const storedTheme =
			localStorage.getItem(THEME_STORAGE_KEY) || DEFAULT_THEME;
		document.documentElement.className = storedTheme;
	}

	// Aplicar tema almacenado inmediatamente
	applyStoredTheme();

	// Configurar event listeners
	const buttons = document.querySelectorAll(".theme-btn");

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const themeId = button.getAttribute("data-theme-id");
			const themeClass = button.getAttribute("data-theme-class");

			if (themeId && themeClass) {
				// Cambiar clase del html
				document.documentElement.className = themeClass;

				// Guardar en localStorage
				localStorage.setItem(THEME_STORAGE_KEY, themeId);
			}
		});
	});
</script>
