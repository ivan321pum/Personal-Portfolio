---
const { position } = Astro.props;

const claseAlineacion = position === 'izquierda' ? 'left-8' : 'right-8';
const claseMenuPosicion = position === 'izquierda' ? 'left-0' : 'right-0';
---
<div class={`dock-container fixed bottom-8 ${claseAlineacion} z-1000`}>
    <div class={`dock-menu absolute hidden gap-2 bg-fondo border border-secundario/20 p-3 rounded-2xl shadow-xl transition-all duration-300 origin-bottom bottom-20 ${claseMenuPosicion}`}>
        <slot name="menu"/>
    </div>

    <button class="dock-trigger flex justify-center items-center min-w-15 h-15 bg-secundario text-fondo rounded-full shadow-lg transition-all duration-300 hover:bg-primario hover:scale-105">
        <slot name="trigger"/>
    </button>
</div>

<script>
    const containers = document.querySelectorAll('.dock-container');

    containers.forEach(container => {
        const trigger = container.querySelector('.dock-trigger');
        const menu = container.querySelector('.dock-menu');

        if (trigger && menu) {
            trigger.addEventListener('click', () => {
                menu.classList.toggle('hidden');
                menu.classList.toggle('flex');
                menu.classList.toggle('flex-col');
            });
        }
    });
</script>
